# --- Telegram (OPTIONAL side-channel) --------------------------------------
# The HTML page (deals.html) is the primary output of every run.
# Telegram is optional and only receives deals with score >= 40.
# Create a bot with @BotFather on Telegram; add it as admin to your channel.
# Uncomment BOTH lines to enable, otherwise you'll see a single INFO line
# that Telegram was skipped.
# TELEGRAM_BOT_TOKEN=123456789:AAF-your-token-here
# TELEGRAM_CHAT_ID=@your_deal_channel

# --- Sources ---------------------------------------------------------------
# The pipeline reads 14 built-in sources (RSS + lightweight scrapes) —
# see the SOURCES registry at the top of deal_finder.py. RSS_FEEDS below
# lists EXTRA feeds on top of the registry; registry URLs are ignored here.
# RSS_FEEDS=https://example.com/another-deal-feed.xml
# Per-source timeout in seconds (one slow site must never stall a run).
SOURCE_TIMEOUT=15
# Local mock affiliate feed file (Awin/CJ placeholder; used only when ALL
# built-in sources come up empty).
AFFILIATE_FEED_FILE=affiliate_feed_sample.json
# Optional: JS-heavy retailer page to scrape with Playwright.
# Leave blank to disable scraping. Selectors are configured at the top of
# deal_finder.py (PRICE_SELECTORS / REVEAL_BUTTON_SELECTORS / CODE_SELECTORS).
SCRAPE_SAMPLE_URL=
# Max real Amazon price scrapes per run when deal_finder.py --scrape is used
# (each scrape takes 5-15 s and burns goodwill with Amazon's bot wall).
MAX_SCRAPE=10

# --- Storage / scheduling ---------------------------------------------------
DATABASE_PATH=deals.db
# Minutes between runs when looping (also overridable via --interval).
INTERVAL_MINUTES=30
LOG_LEVEL=INFO
